# ----------------------------------------------------------------------------
# Database
# ----------------------------------------------------------------------------
# This project uses PostgreSQL (prisma/schema.prisma -> provider = "postgresql").
# Production: use a managed Postgres (Neon, Supabase, Vercel Postgres, Render...).
#   DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
# For Neon, append ?sslmode=require to the connection string.
#
# Local development options:
#   (a) point this at a free Neon dev branch / local Postgres, OR
#   (b) for quick local SQLite, set provider = "sqlite" in schema.prisma and use
#       DATABASE_URL="file:./dev.db" (do not commit that schema change).
DATABASE_URL="postgresql://user:password@localhost:5432/solar?schema=public"

# ----------------------------------------------------------------------------
# NextAuth
# ----------------------------------------------------------------------------
# Generate a strong secret with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# ----------------------------------------------------------------------------
# Business / contact config
# ----------------------------------------------------------------------------
# WhatsApp number in international format without "+" or spaces.
NEXT_PUBLIC_WHATSAPP_NUMBER="919390185447"

# Public site URL (no trailing slash) — used for SEO sitemap/canonical/OpenGraph.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Seed admin credentials (used by prisma/seed.ts). Change in production.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="admin12345"
