# ----------------------------------------------------------------------------
# Database
# ----------------------------------------------------------------------------
# Local development uses SQLite. For production (e.g. Vercel + Postgres),
# change the provider in prisma/schema.prisma to "postgresql" and set this to
# your Postgres connection string, e.g.:
#   DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"
DATABASE_URL="file:./dev.db"

# ----------------------------------------------------------------------------
# NextAuth
# ----------------------------------------------------------------------------
# Generate a strong secret with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# ----------------------------------------------------------------------------
# Business / contact config
# ----------------------------------------------------------------------------
# WhatsApp number in international format without "+" or spaces (placeholder).
NEXT_PUBLIC_WHATSAPP_NUMBER="919999999999"

# Public site URL (no trailing slash) — used for SEO sitemap/canonical/OpenGraph.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Seed admin credentials (used by prisma/seed.ts). Change in production.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="admin12345"
